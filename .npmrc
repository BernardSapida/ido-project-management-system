# @bernardsapida/web-ui (the Component Labs) comes from GitHub Packages, not npmjs.
@bernardsapida:registry=https://npm.pkg.github.com

# The auth token does NOT belong in this file - it is committed, and pnpm refuses to
# expand env vars in credentials from a PROJECT .npmrc anyway (it would let a hostile
# registry line exfiltrate the secret). Two trusted sources instead:
#   - your machine:  pnpm config set "//npm.pkg.github.com/:_authToken" <token>
#   - CI (Netlify):  see .npmrc.ci and NPM_CONFIG_USERCONFIG in netlify.toml

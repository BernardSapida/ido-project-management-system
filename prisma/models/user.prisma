enum Role {
  USER
  ADMIN
  IDO_OFFICER
  IDO_CHAIRPERSON
  DIRECTOR
  BUDGET_OFFICER
}

enum STATUS {
  active
  inactive
  suspended
}

model User {
  id              String   @id
  name            String
  firstname       String
  lastname        String
  role            Role     @default(USER)
  position        String?
  signatureUrl    String?
  profileComplete Boolean  @default(false)
  email           String   @unique
  emailVerified   Boolean  @default(false)
  image           String?
  status          STATUS   @default(inactive)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  session         Session[]
  account         Account[]
  requests        Request[]        @relation("UserRequests")
  auditLogs       AuditLog[]       @relation("UserAuditLogs")
  requestComments RequestComment[] @relation("UserRequestComments")
  permissions     UserPermission[]

  @@map("users")
}

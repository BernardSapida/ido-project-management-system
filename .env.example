# ── Client (must be prefixed with VITE_) ──
# App base URL.
VITE_BASE_URL=http://localhost:4000

# ── Server (required) ──
# Better Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ── Server (optional) ──
# External server URL (SSR / server functions).
SERVER_URL=

# Mobile dev host for Expo / device testing. Added to Better Auth trustedOrigins.
# MUST exactly match the Origin the native app sends (its EXPO_PUBLIC_API_URL),
# INCLUDING the port — any mismatch makes sign-in fail with 403 "Invalid origin".
MOBILE_DEV_URL=http://192.168.0.100:4000

# App version gating.
APP_VERSION=1.0.0
MINIMUM_APP_VERSION=1.0.0

# Maintenance mode.
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=

# ── S3 image storage (required only if the project uploads files) ──
# Put these in .env or .env.local — Vite loads both, and .env.local wins.
# Both are gitignored (.env directly, .env.local via *.local).
#
# All four or none. Leave them blank and the app runs normally; only an upload
# fails, with a message naming the ones that are missing.
#
# SERVER ONLY — never give these a VITE_ prefix. That ships a secret key to
# every visitor. The browser calls `upload.presign`, gets a URL that expires in
# five minutes, and PUTs the file straight to S3.
#
# Setup runbook, including the bucket policy and CORS rule you must add by hand:
#   ../infrastructure/docs/aws/s3-setup.md
APP_AWS_REGION=ap-southeast-1
APP_AWS_S3_BUCKET=
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=

# ── Pusher (optional, realtime) ──
PUSHER_APP_ID=
PUSHER_APP_SECRET=
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=ap1

# Installing @bernardsapida/web-ui from GitHub Packages (CI only)
#
# Not app variables - nothing in src/env.ts reads them. They configure the package
# manager on the host that builds you, so they belong in that host's settings,
# never in a generated .env. Both values are SINGLE LINE.
#
#   NPM_CONFIG_USERCONFIG  path to .npmrc.ci inside the build checkout
#   NPM_TOKEN              a GitHub PAT with read:packages - the token ALONE
#
# NETLIFY already sets the first in netlify.toml (/opt/build/repo/.npmrc.ci), so
# add only NPM_TOKEN under Site configuration -> Environment variables.
#
# VERCEL presets nothing. Add BOTH under Settings -> Environment Variables:
#
#   NPM_CONFIG_USERCONFIG=/vercel/path0/.npmrc.ci
#   NPM_TOKEN=<a GitHub PAT with read:packages>
#
# NPM_TOKEN on its own is not enough on Vercel: Vercel binds a bare NPM_TOKEN to
# registry.npmjs.org only, so npm.pkg.github.com gets no authorization header and
# the install dies on ERR_PNPM_FETCH_401 with the PAT visibly attached to the
# wrong host. NPM_CONFIG_USERCONFIG is what promotes .npmrc.ci to the USER config
# - the only place pnpm expands ${NPM_TOKEN}. In a committed project .npmrc it
# drops the variable with a bare [WARN], so the install goes out unauthenticated
# while looking correctly configured.
#
# A variable named NPM_RC holding a whole .npmrc also works, but its value must be
# three REAL lines. Pasted as one joined line it makes the DEFAULT registry the
# entire string, and even fetching pnpm itself 404s. The two variables above have
# no multi-line value and so cannot fail that way.

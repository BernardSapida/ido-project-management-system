# ── Client (must be prefixed with VITE_) ──
# App base URL.
VITE_BASE_URL=http://localhost:4000

# ── Server (required) ──
# Better Auth secret — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ── Server (optional) ──
# External server URL (SSR / server functions).
SERVER_URL=

# Mobile dev host for Expo / device testing. Added to Better Auth trustedOrigins.
# MUST exactly match the Origin the native app sends (its EXPO_PUBLIC_API_URL),
# INCLUDING the port — any mismatch makes sign-in fail with 403 "Invalid origin".
MOBILE_DEV_URL=http://192.168.0.100:4000

# App version gating.
APP_VERSION=1.0.0
MINIMUM_APP_VERSION=1.0.0

# Maintenance mode.
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=

# ── S3 image storage (required only if the project uploads files) ──
# Put these in .env or .env.local — Vite loads both, and .env.local wins.
# Both are gitignored (.env directly, .env.local via *.local).
#
# All four or none. Leave them blank and the app runs normally; only an upload
# fails, with a message naming the ones that are missing.
#
# SERVER ONLY — never give these a VITE_ prefix. That ships a secret key to
# every visitor. The browser calls `upload.presign`, gets a URL that expires in
# five minutes, and PUTs the file straight to S3.
#
# Setup runbook, including the bucket policy and CORS rule you must add by hand:
#   ../infrastructure/docs/aws/s3-setup.md
APP_AWS_REGION=ap-southeast-1
APP_AWS_S3_BUCKET=
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=

# ── Pusher (optional, realtime) ──
PUSHER_APP_ID=
PUSHER_APP_SECRET=
VITE_PUSHER_KEY=
VITE_PUSHER_CLUSTER=ap1

# Installing @bernardsapida/web-ui from GitHub Packages (CI only)
#
# Not an app variable - nothing in src/env.ts reads it. It configures the package
# manager on the host that builds you, so it belongs in that host's settings, not
# in a generated .env.
#
# On VERCEL, set a variable named NPM_RC - NOT NPM_TOKEN. Vercel only ever writes
# NPM_TOKEN against registry.npmjs.org, so a GitHub PAT put there authenticates
# the wrong host and the install dies on ERR_PNPM_FETCH_401. NPM_RC takes
# precedence and is written verbatim as the .npmrc. Its value is a whole file -
# three REAL lines, not one joined line:
#
#   registry=https://registry.npmjs.org/
#   @bernardsapida:registry=https://npm.pkg.github.com
#   //npm.pkg.github.com/:_authToken=<a GitHub PAT with read:packages>
#
# Keep the registry.npmjs.org line: Vercel rejects an NPM_RC without it.
#
# On NETLIFY the same problem has a different answer, already wired up: see
# .npmrc.ci plus NPM_CONFIG_USERCONFIG in netlify.toml, which only needs a bare
# NPM_TOKEN holding the PAT.

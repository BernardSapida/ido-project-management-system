{
  "name": "npm-tanstack-start-monolith-template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite dev --port 4000",
    "generate-routes": "tsr generate",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "post-cta-init": "npx -y create-db@latest --user-agent tanstack/tsrouter",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:migrate": "dotenv -e .env.local -- prisma migrate dev",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "db:seed": "dotenv -e .env.local -- prisma db seed",
    "generate:palettes": "tsx scripts/generate-palettes.ts",
    "s3:sweep": "dotenv -e .env.local -e .env -- tsx scripts/s3-sweep.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@aws-sdk/s3-request-presigner": "^3.1111.0",
    "@bernardsapida/web-ui": "^0.4.9",
    "@heroui/react": "^3.2.1",
    "@heroui/styles": "^3.2.1",
    "@hookform/resolvers": "^5.2.2",
    "@internationalized/date": "^3.12.3",
    "@netlify/vite-plugin-tanstack-start": "^1.3.0",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.8.0",
    "@react-pdf/renderer": "^4.6.1",
    "@t3-oss/env-core": "^0.13.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-query-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.132.0",
    "@trpc/client": "^11.11.0",
    "@trpc/server": "^11.11.0",
    "@trpc/tanstack-react-query": "^11.11.0",
    "@types/nprogress": "^0.2.3",
    "better-auth": "^1.5.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.545.0",
    "moment": "^2.30.1",
    "nitro": "3.0.260610-beta",
    "nprogress": "^0.2.0",
    "pusher": "^5.3.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.2",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.3",
    "uuid": "^13.0.0",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.167.21",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "cypress": "^15.15.0",
    "dotenv-cli": "^11.0.0",
    "jsdom": "^28.1.0",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.2",
    "vite": "^8.2.0",
    "vitest": "^3.0.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
